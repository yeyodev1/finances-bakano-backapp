DB_URI=mongodb+srv://user:pass@cluster.mongodb.net/finances-bakano?retryWrites=true&w=majority
PORT=8200
NODE_ENV=development
TZ=America/Guayaquil

JWT_SECRET=your_secret_key

RESEND_API_KEY=
RESEND_FROM_EMAIL=Bakano Finanzas <financiero@bakano.ec>
RESEND_REPLY_TO=financiero@bakano.ec
RESEND_DEFAULT_TO=dreyes@bakano.ec

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

METRICS_API_URL=http://localhost:8100/api
FINANCE_API_KEY=

# Banco (Mercury) — token de SOLO LECTURA, con el prefijo "secret-token:" incluido.
# Requiere que la IP saliente del servidor esté en el whitelist del token.
MERCURY_API_URL=https://api.mercury.com/api/v1
MERCURY_API_TOKEN=
MERCURY_TIMEOUT_MS=20000
MERCURY_CACHE_TTL=60

APP_URL=http://localhost:5173
CRON_SECRET=
CRON_ENABLED=true

SEED_ADMIN_EMAIL=dreyes@bakano.ec
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Diego Reyes

SLACK_ERROR_WEBHOOK=

JWT_EXPIRES_IN=30d

# Stripe (sk_ o rk_ restricted; en develop va la restricted de test)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Clave con la que metrics-backapp consume /api/portal (header x-metrics-key)
METRICS_PROXY_KEY=
